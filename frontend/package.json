{
  "name": "pulsedesk-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --poll 1000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "format:check": "prettier --check .",
    "openapi:export": "sh scripts/export-openapi.sh",
    "openapi:generate": "sh scripts/generate-openapi.sh",
    "openapi:refresh": "npm run openapi:export && npm run openapi:generate"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/material": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "angular-eslint": "22.5.0",
    "eslint": "10.9.1",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
